# Copy to .env (npm run setup does it for you). Never commit or share the real .env.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# --- Supabase Postgres (Supabase → Connect → ORMs → Prisma) ---
# App queries: transaction pooler, port 6543, with pgbouncer=true
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations: session pooler / direct, port 5432
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Optional: database connections per server instance (default 5 on Vercel, 10 elsewhere)
# DB_CONNECTION_LIMIT=5

# --- Sign-in (random, 32+ characters; npm run setup generates it) ---
AUTH_SECRET=""

# --- Vapi (dashboard.vapi.ai → API Keys) ---
# Private key: server only, places outbound calls
VAPI_API_KEY=""
# Public key: used by the browser test call (safe to expose, it can only start web calls)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=""
# Shared secret for the webhook (24+ characters). Put the same value in a Vapi "Bearer Token" credential.
VAPI_WEBHOOK_SECRET=""

# --- Dialer heartbeat (Vercel Cron sends it automatically as Authorization: Bearer …) ---
CRON_SECRET=""

# --- Public address of this app (SEO links, sitemap, settings page) ---
APP_URL="http://localhost:3000"

# --- First admin, used once by npm run db:seed ---
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
